# Ejemplo de .env para centinela-ai
AI_PROVIDER=nvidia_nim
AI_MODEL=meta/llama-3-70b-instruct
AI_MODEL_GOOGLE=gemini-1.5-flash-latest
AI_PROVIDER_ORDER=google_genai,nvidia_nim,openrouter,groq,ollama

# NVIDIA
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenRouter / OpenAI-compatible
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Google
GOOGLE_API_KEY=

# Vault (opcional)
VAULT_ADDR=
VAULT_TOKEN=

# Otros
GROQ_API_KEY=
LMSTUDIO_API_KEY=

# DB / redis (entorno de despliegue)
DB_HOST=10.4.3.23
DB_NAME=centinela_db
DB_USER=centinela_user
DB_PASSWORD=centinela_sec_db_2026
VALKEY_HOST=10.4.3.23

# Authentik
AUTHENTIK_URL=https://auth.casmart.internal
AUTHENTIK_CLIENT_ID=centinela-ai
AUTHENTIK_CLIENT_SECRET=

# GitLab Repository Integration
GITLAB_URL=http://10.4.3.10
GITLAB_TOKEN=

# Wazuh Manager (self-hosted by docker-compose service wazuh-manager on this host)
WAZUH_MANAGER_HOST=
WAZUH_API_ENDPOINT=

# GID of the host's "docker" group, so app containers can exec into the Wazuh
# manager container over the mounted docker.sock. Find it with:
#   getent group docker | cut -d: -f3
DOCKER_GID=136
