# Ejemplo de .env para centinela-ai
AI_PROVIDER=nvidia_nim
AI_MODEL=meta/llama-3-70b-instruct
AI_MODEL_GOOGLE=gemini-1.5-flash-latest
AI_PROVIDER_ORDER=google_genai,nvidia_nim,openrouter,groq,ollama

# NVIDIA
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=***REMOVED-SECRET***

# OpenRouter / OpenAI-compatible
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Google
GOOGLE_API_KEY=

# Vault (opcional)
VAULT_ADDR=
VAULT_TOKEN=

# Otros
GROQ_API_KEY=
LMSTUDIO_API_KEY=

# DB / redis (entorno de despliegue)
DB_HOST=***REMOVED-SECRET***
DB_NAME=
DB_USER=
DB_PASSWORD=
VALKEY_HOST=***REMOVED-SECRET***
