# Ejemplo de .env para centinela-ai
AI_PROVIDER=nvidia_nim
AI_MODEL=meta/llama-3-70b-instruct
AI_MODEL_GOOGLE=gemini-1.5-flash-latest
AI_PROVIDER_ORDER=google_genai,nvidia_nim,openrouter,groq,ollama

# NVIDIA
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenRouter / OpenAI-compatible
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Google
GOOGLE_API_KEY=

# Vault (opcional)
VAULT_ADDR=
VAULT_TOKEN=

# Otros
GROQ_API_KEY=
LMSTUDIO_API_KEY=

# DB / redis (entorno de despliegue)
DB_HOST=10.4.3.23
DB_NAME=centinela_db
DB_USER=centinela_user
DB_PASSWORD=centinela_sec_db_2026
VALKEY_HOST=10.4.3.23

# Authentik
AUTHENTIK_URL=https://auth.casmart.internal
AUTHENTIK_CLIENT_ID=centinela-ai
AUTHENTIK_CLIENT_SECRET=

# GitLab Repository Integration
GITLAB_URL=http://10.4.3.10
GITLAB_TOKEN=

# SonarQube (auditors/auditor_sonarqube.py) -- dedicated instance for Centinela-AI,
# separate from any other SonarQube deployment. SONAR_TOKEN is a dedicated technical
# user's analysis token, never the admin token. HOST_PROJECT_ROOT is the real host path
# this repo is checked out at (needed so sonar-scanner, run as a sibling container via
# docker.sock, can bind-mount the real host path -- see auditor_sonarqube.py's docstring).
SONAR_HOST_URL=http://centinela-sonarqube:9000
SONAR_TOKEN=
HOST_PROJECT_ROOT=/opt/centinela-ai

# SonarQube's own dedicated Postgres database on 10.4.3.23 (centinela_sonarqube_db, NOT
# centinela_db, and NOT sonarqube_db -- that name is already used by an unrelated
# SonarQube instance on another server).
SONARQUBE_DB_USER=centinela_sonarqube_user
SONARQUBE_DB_PASSWORD=

# Wazuh Manager (self-hosted by docker-compose service wazuh-manager on this host)
WAZUH_MANAGER_HOST=
WAZUH_API_ENDPOINT=

# GID of the host's "docker" group, so app containers can exec into the Wazuh
# manager container over the mounted docker.sock. Find it with:
#   getent group docker | cut -d: -f3
DOCKER_GID=136
